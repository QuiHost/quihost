{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "yarn install --network-timeout 300000 --ignore-optional --ignore-platform",
  "buildCommand": "yarn build",
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": "--max_old_space_size=4096"
    }
  }
} 