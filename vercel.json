{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps --network-timeout 300000",
  "buildCommand": "npm run build",
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": "--max_old_space_size=4096"
    }
  }
} 