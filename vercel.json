{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps --force && npx prisma generate",
  "buildCommand": "npm run build",
  "env": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": "--max_old_space_size=4096",
      "PRISMA_GENERATE_IN_POSTINSTALL": "true",
      "NEXT_PUBLIC_VERCEL_ENV": "production"
    }
  },
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": {
      "memory": 3008,
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "next.config.js",
      "use": "@vercel/next"
    }
  ]
} 