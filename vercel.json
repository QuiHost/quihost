{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps && npx prisma generate",
  "buildCommand": "npm run build",
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": "--max_old_space_size=4096",
      "PRISMA_GENERATE_IN_POSTINSTALL": "true"
    }
  },
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": {
      "memory": 3008,
      "maxDuration": 10
    }
  }
} 