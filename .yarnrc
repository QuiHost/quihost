--install.ignore-engines true
--install.ignore-platform true
--install.ignore-optional true
--install.ignore-scripts false
--install.check-files true
--install.frozen-lockfile false
--install.pure-lockfile false
--install.network-timeout 100000
--install.production false
--install.non-interactive true
--install.verbose true
--network-concurrency 1
--network-timeout 300000
--prefer-offline true
--registry https://registry.npmjs.org/ 